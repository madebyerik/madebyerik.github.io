---
import Card from './Card.astro';
import type { WorkId } from "./Card.astro";
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const formattedIndex = String(Number(data.index) + 1).padStart(2, '0');
---

<Card variant={id as WorkId} href={`/work/${id}`}>
  <div class="work-card__inner">
    <div class="work-card__left">
      <svg
        class="work-card__index"
        viewBox="0 0 32 32"
        role="img"
        aria-label={`Project ${formattedIndex}`}>
        <text x="16" y="16"
          text-anchor="middle" dominant-baseline="middle">
          {formattedIndex}
        </text>
      </svg>
      <div class="work-card__info">
        <h5 class="work-card__category">{data.category}</h5>
        <h3 class="work-card__title">{data.title}</h3>
        <p class="work-card__description">{data.description}</p>
      </div>
      <div class="work-card__tags-container">
        <ul class="work-card__tag-list">
          {data.tags.map((tag: string) => (
            <li class="work-card__tag">{tag}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="work-card__right">
      <img class="work-card__img" src={data.img.src} alt={data.img_alt} />
    </div>
  </div>
</Card>

<style>
  .work-card__inner {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    min-width: 0;
  }

  .work-card__left {
    display: flex;
    flex-direction: column;
    justify-content: start;
    gap: 0.75rem;
    min-width: 0;
    width: auto;
  }

  .work-card__index {
    position: absolute;
    display: block;
    width: 2rem;
    height: 2rem;
    overflow: visible;
    top: 1.125rem;
    right: 1.5rem;
  }

  .work-card__index text {
    font-family: var(--font-family-serif);
    font-size: 1.875rem;
    font-weight: 700;
    fill: white;
    stroke: black;
    stroke-width: 2px;
    paint-order: stroke fill;
    stroke-linejoin: round;
    filter: drop-shadow(-1px 1px 0px rgba(0, 0, 0, 1));
  }

  .work-card__index-text--desktop {
    display: none;
  }

  .work-card__category {
    font-size: 1rem;
    line-height: 1.5rem;
    font-family: var(--font-family-serif);
    font-weight: bold;
    font-style: italic;
    color: rgba(0,0,0,0.70);
  }

  .work-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .work-card__title {
    font-size: 2.5rem;
    line-height: 3rem;
    font-family: var(--font-family-serif);
    font-weight: bold;
    font-style: italic;
    color: black;
  }

  .work-card__description {
    font-size: 1.125rem;
    line-height: 1.875rem;
    font-family: var(--font-family-sans);
    color: rgba(0,0,0,0.5);
  }

  .work-card__img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top left;
    width: 100%;
    max-width: 800px;
    box-shadow: 0 0 0 1px black, -3px 3px 0 0 black;
    border-radius: 1rem;
    min-width: 0;
  }

  .work-card__tags-container {
    min-width: 0;
    width: 100%;
    overflow: scroll;
    padding: 0.1875rem;
    border-radius: 1rem;
  }

  .work-card__tag-list {
    list-style-type: none;
    flex-wrap: nowrap;
    width: 100%;
    padding: 0;
    display: flex;
    gap: 0.75rem 0.5rem;
    min-width: 0;
  }

  .work-card__tag {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 1rem;
    line-height: 2rem;
    font-family: var(--font-family-sans);
    color: black;
    background: white;
    padding: 0 0.75rem;
    border-radius: 1rem;
    box-shadow: 0 0 0 1px black, -1.5px 2.5px 0 black;
  }

  @media (min-width: 48rem) {
    .work-card__inner {
      flex-direction: row;
      justify-content: space-between;
      gap: clamp(1.5rem, 4vw, 2rem);
      /* gap: 32px; */
    }

    .work-card__left {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .work-card__right {
      flex: 0 1 clamp(240px, 38vw, 360px);
      width: auto;
      min-width: 0;
    }

    .work-card__img {
      max-width: none;
    }

    .work-card__index {
      position: inherit;
      top: auto;
      right: auto;
    }

    .work-card__category {
      padding-bottom: 0;
    }

    .work-card__index text {
      font-size: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .work-card__inner {
      gap: 4rem;
    }

    .work-card__right {
      flex-basis: 400px;
    }

    .work-card__title {
      font-size: 3rem;
      line-height: 3.5rem;
    }

    .work-card__description {
      font-size: 1.25rem;
      line-height: 2rem;
    }

    .work-card__index text {
      font-size: 2.25rem;
    }
  }
</style>