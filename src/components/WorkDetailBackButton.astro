---
import type { WorkId } from "./Card.astro";

interface Props {
  variant: WorkId;
}

const { variant } = Astro.props;
---

<div class:list={['back', `back--${variant}`]}>
  <a class="back__link" href="/work">← Work</a>
</div>

<style>
	.back {
		display: flex;
		align-items: center;
		padding: 0 0.75rem 0 0.875rem;
		border-radius: 2rem;
	}

	.back__link {
    white-space: nowrap;
    font-size: 1rem;
    line-height: 2rem;
    font-family: var(--font-family-sans);
    color: black;
    background: white;
    padding: 0 0.75rem;
    border-radius: 1rem;
    box-shadow: 0 0 0 1px black, -1.5px 2.5px 0 black;
		text-decoration: none;
	}

  .back--btwx {
    background-image: var(--gradient-btwx-200);
  }

  .back--caffeine {
    background-image: var(--gradient-caffeine-200);
  }

  .back--twitch {
    background-image: var(--gradient-twitch-200);
  }

  .back--figma {
    background-image: var(--gradient-figma-200);
  }

  .back--next {
    background-image: var(--gradient-next-200);
  }

  @media (min-width: 48rem) {
    .back {
      padding: 0 1rem 0 1.125rem;
    }
  }

  @media (min-width: 64rem) {
    
  }
</style>