---
import type { WorkId } from "./Card.astro";

interface Props {
  variant: WorkId;
  src: string;
  alt?: string;
}

const { variant, src, alt } = Astro.props;
---

<div class:list={['preview', `preview--${variant}`]}>
  <img class="preview__img" src={src} alt={alt} />
</div>

<style>
	.preview {
    padding: 1.5rem 1.5rem 1.5rem 1.75rem;
    border-radius: 2rem;
  }

  .preview__img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top left;
    width: 100%;
    max-width: 800px;
    box-shadow: 0 0 0 1px black, -3px 3px 0 0 black;
    border-radius: 1rem;
    min-width: 0;
  }

  .preview--btwx {
    background-image: var(--gradient-btwx-200);
  }

  .preview--caffeine {
    background-image: var(--gradient-caffeine-200);
  }

  .preview--twitch {
    background-image: var(--gradient-twitch-200);
  }

  .preview--figma {
    background-image: var(--gradient-figma-200);
  }

  .preview--next {
    background-image: var(--gradient-next-200);
  }

  @media (min-width: 48rem) {
    .preview {
      padding: 32px 32px 32px 36px;
    }
    
    .preview__img {
      max-width: none;
    }
  }

  @media (min-width: 64rem) {
    
  }
</style>