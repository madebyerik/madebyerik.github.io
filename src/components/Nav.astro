<script>
  const button = document.querySelector('.nav__menu');
  const menu = document.querySelector('.nav__links');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  });
</script>

<style>
  .nav {
    position: sticky;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding: 8px;
    background: white;
    top: 0px;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    border: none;
    grid-column: 1;
    justify-self: start;
    background: none;
    padding: 0;
  }

  .nav__menu svg {
    position: relative;
    top: -1px;
  }

  .nav__logo {
    display: flex;
    grid-column: 2;
    justify-self: center;
    align-self: center;
    align-items: center;
  }

  .nav__logo svg {
    position: relative;
    top: -1px;
  }

  .nav__links {
    display: none;
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .nav__links.is-open {
    display: grid;
    padding: 8px 0;
  }

  .nav__links a {
    font-size: 16px;
    line-height: 24px;
    text-decoration: none;
    padding: 4px 12px;
    border-radius: 16px;
    color: black;
    font-family: var(--font-family-sans);
    font-weight: bold;
  }

  .nav__links a.active {
		background: black;
    color: white;
    font-family: var(--font-family-serif);
    font-style: italic;
	}

  @media (min-width: 768px) {
    .nav {
      top: 8px;
      border-radius: 32px;
    }

    .nav__menu {
      display: none;
    }

    .nav__links {
      display: flex;
      align-self: center;
      grid-column: 1;
      grid-row: 1;
      gap: 1rem;
    }
  }
</style>