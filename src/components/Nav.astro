---
import menuIcon from '../assets/menu.svg';
import logo from '../assets/logo.svg';

const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work' }
];
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav class="nav" aria-label="Primary navigation">
  <div class="nav__inner">
    <button
      class="nav__menu"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu">
      <img src={menuIcon.src} />
    </button>
    <a class="nav__logo" href="/">
      <img src={logo.src} />
    </a>
    <div id="main-menu" class="nav__links">
      {
        textLinks.map((link) => (
          <a class={isCurrentPage(link.href) ? 'active' : null} href={link.href}>
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const button = document.querySelector('.nav__menu');
  const menu = document.querySelector('.nav__links');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0px;
    z-index: 999;
    grid-template-columns: 
      [gutter-left] 0 
      [content] 100%
      [gutter-right] 0;
    justify-content: center;
  }

  .nav > * {
    grid-column: content;
  }

  .nav__inner {
    background: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: 0 0px 10px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.1);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding: 0.5rem;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    border: none;
    grid-column: 1;
    justify-self: start;
    background: none;
    padding: 0;
  }

  .nav__menu img {
    position: relative;
    top: -1px;
  }

  .nav__logo {
    display: flex;
    grid-column: 2;
    justify-self: center;
    align-self: center;
    align-items: center;
  }

  .nav__logo img {
    position: relative;
    top: -1px;
  }

  .nav__links {
    display: none;
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .nav__links.is-open {
    display: grid;
    padding: 0.5rem 0 0 0;
  }

  .nav__links a {
    font-size: 1rem;
    line-height: 1.5rem;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    color: black;
    text-align: center;
    font-family: var(--font-family-sans);
    font-weight: bold;
  }

  .nav__links a.active {
		background: black;
    color: white;
    font-family: var(--font-family-serif);
    font-style: italic;
	}

  @media (min-width: 48rem) {
    .nav {
      padding-top: 0.5rem;
      display: grid;
      grid-template-columns: 
        [gutter-left] var(--gutter) 
        [content] minmax(0, 64rem)
        [gutter-right] var(--gutter);
    }

    .nav__inner {
      border-radius: 2rem;
    }

    .nav__menu {
      display: none;
    }

    .nav__links {
      display: flex;
      align-self: center;
      grid-column: 1;
      grid-row: 1;
    }

    .nav__links a {
      padding: 0.25rem 0.75rem;
    }
  }

  @media (min-width: 64rem) {
    
  }
</style>