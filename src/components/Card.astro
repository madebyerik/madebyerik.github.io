---
export type WorkId = 'btwx' | 'caffeine' | 'twitch' | 'figma' | 'next';
type Variant = 'blue' | 'pink' | 'purple' | 'green' | WorkId;

interface Props {
  variant?: Variant;
  href?: string;
  target?: string;
}

const { variant = 'pink', href, target = "_self" } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class:list={['card', `card--${variant}`]} href={href} target={target}>
  <div class="card__inner">
    <slot />
  </div>
</Tag>

<style>
	.card {
    display: block;
		background: white;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.1), 0 0 10px 0 rgba(0,0,0,0.05);
		border-radius: 2rem;
		padding: 1rem;
    text-decoration: none;
    min-width: 0;
	}

	.card__inner {
		position: relative;
		width: 100%;
		transform: translate(0.375rem, -0.375rem);
		border-radius: 1.25rem;
    padding: 1.5rem;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			box-shadow: 0 0 0 1px inset black;
			border-radius: 1.5rem;
      pointer-events: none;
		}

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			transform: translate(-0.625rem, 0.625rem);
			border-radius: 1.25rem;
			z-index: -1;
		}
	}

  .card--blue {
    .card__inner {
      &::before {
        background-image: linear-gradient(
          to bottom right,
          var(--color-cyan-100),
          var(--color-blue-100),
          var(--color-violet-100)
        );
      }
    }
  }

  .card--pink {
    .card__inner {
      &::before {
        background-image: linear-gradient(
          to top left,
          var(--color-pink-100),
          var(--color-orange-100),
          var(--color-yellow-100)
        );
      }
    }
  }

  .card--purple {
    .card__inner {
      &::before {
        background-image: linear-gradient(
          to top left,
          var(--color-blue-100),
          var(--color-purple-100),
          var(--color-pink-100)
        );
      }
    }
  }

  .card--green {
    .card__inner {
      &::before {
        background-image: linear-gradient(
          to bottom right,
          var(--color-indigo-100),
          var(--color-cyan-100),
          var(--color-teal-100)
        );
      }
    }
  }

  .card--btwx {
    .card__inner {
      &::before {
        background-image: var(--gradient-btwx-100);
      }
    }
  }

  .card--caffeine {
    .card__inner {
      &::before {
        background-image: var(--gradient-caffeine-100);
      }
    }
  }

  .card--twitch {
    .card__inner {
      &::before {
        background-image: var(--gradient-twitch-100);
      }
    }
  }

  .card--figma {
    .card__inner {
      &::before {
        background-image: var(--gradient-figma-100);
      }
    }
  }

  .card--next {
    .card__inner {
      &::before {
        background-image: var(--gradient-next-100);
      }
    }
  }

	@media (min-width: 48rem) {
    .card {
      padding: 1.25rem 1.25rem 1rem 1rem;
    }

    .card__inner {
      padding: 1.75rem;

      transform: translate(0.5rem, -0.5rem);

      &::before {
        transform: translate(-0.75rem, 0.75rem);
      }
    }
  }

  @media (min-width: 64rem) {
    .card {
      padding: 1.5rem 1.5rem 1.25rem 1.25rem;
    }

    .card__inner {
      padding: 2rem;

      transform: translate(0.625rem, -0.625rem);

      &::before {
        transform: translate(-0.875rem, 0.875rem);
      }
    }
  }
</style>