---
import type { WorkId } from "./Card.astro";

interface Props {
  variant: WorkId;
  tags: string[];
}

const { variant, tags } = Astro.props;
---

<div>
  <div class:list={['tags', `tags--${variant}`]}>
    <div class="tags__container">
      <ul class="tags__list">
        {tags.map((tag: string) => (
          <li class="tags__tag">{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .tags {
    display: inline-block;
		padding: 0.75rem 0.75rem 0.875rem 0.875rem;
		border-radius: 2rem;
    max-width: 100%;
  }

  .tags__container {
    min-width: 0;
    width: 100%;
    overflow: scroll;
    padding: 0.1875rem;
    border-radius: 1.5rem;
  }

  .tags__list {
    display: flex;
    list-style-type: none;
    flex-wrap: nowrap;
    padding: 0;
    gap: 1rem 0.75rem;
    min-width: 0;
  }

  .tags__tag {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 1rem;
    line-height: 2rem;
    font-family: var(--font-family-sans);
    color: black;
    background: white;
    padding: 0 0.75rem;
    border-radius: 1rem;
    box-shadow: 0 0 0 1px black, -1.5px 2.5px 0 black;
  }

  .tags--btwx {
    background-image: var(--gradient-btwx-200);
  }

  .tags--caffeine {
    background-image: var(--gradient-caffeine-200);
  }

  .tags--twitch {
    background-image: var(--gradient-twitch-200);
  }

  .tags--figma {
    background-image: var(--gradient-figma-200);
  }

  .tags--next {
    background-image: var(--gradient-next-200);
  }

  @media (min-width: 48rem) {
    .tags {
      padding: 1rem 1rem 1.125rem 1.125rem;
      border-radius: 2.25rem;
    }
    .tags__container {
      border-radius: 1.125rem;
    }
  }

  @media (min-width: 64rem) {

  }
</style>