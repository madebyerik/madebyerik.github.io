---
import memoji from '../assets/memoji-clouds.png';
---

<section class="hero">
  <h1 class="hero__text">Hello, I'm <span>Erik</span>.<br>I specialize in <span>Product Design</span>.</h1>
  <img class="hero__memoji" src={memoji.src} fetchpriority="high" />
	<div class="hero__background"></div>
</section>

<style>
  .hero {
    --gutter: clamp(1rem, 3vw, 2rem);
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    aspect-ratio: 9 / 16;
    min-height: 26rem;
    max-height: 45rem;
    overflow: clip;
    margin-top: 1rem;
  }

  .hero__background {
    position: absolute;
    inset: var(--gutter);
    z-index: -1;
    border-radius: var(--radius);
    background: linear-gradient(
      to bottom right,
      var(--color-fuchsia-100),
      var(--color-pink-100),
      var(--color-orange-100),
      var(--color-yellow-100)
    );
    border-radius: 32px;
  }

  .hero__text {
    z-index: 1;
    color: rgb(0 0 0 / 50%);
    font-family: var(--font-family-sans);
    font-size: clamp(2.75rem, 3.8vw + 1.4rem, 4rem);
    font-weight: normal;
    font-style: normal;
    line-height: 1.33;

    span {
      color: rgb(0 0 0);
      font-family: var(--font-family-serif);
      font-style: italic;
      font-weight: bold;
    }
  }

  .hero__memoji {
    position: absolute;
    right: clamp(-1.25rem, -2vw, -0.25rem);
    bottom: clamp(-1.25rem, -3vw, -0.5rem);
    z-index: 0;
    width: clamp(12.25rem, 22vw, 16rem);
    max-width: 48%;
    object-fit: contain;
  }

  @media (min-width: 48rem) {
    .hero {
      aspect-ratio: 4 / 3;
      min-height: 40rem;
      max-height: 45rem;
      margin-top: 0;
    }
  }

  @media (min-width: 64rem) {
    
  }
</style>
