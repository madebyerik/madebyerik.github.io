---
import memoji from '../assets/memoji-clouds.png';
---

<section class="hero">
  <h1 class="hero__text">Hello, I'm <span>Erik</span>.<br>I specialize in <span>Product Design</span>.</h1>
  <img class="hero__memoji" src={memoji.src} fetchpriority="high" />
	<div class="hero__background"></div>
</section>

<style>
	.hero {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 720px;
    min-height: 320px;
    display: flex;
    align-items: center;
  }

  .hero__background {
    position: absolute;
    inset: 32px;
    background-image: linear-gradient(to top right, var(--color-pink-100) 60%, var(--color-yellow-100));
    border-radius: 32px;
    z-index: -1;
  }

  .hero__memoji {
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 0;
    width: 224px;
    object-fit: contain;
    transform: translate(10%, -10%);
  }

  .hero__text {
    font-family: var(--font-family-sans);
    font-size: 64px;
    line-height: 88px;
    font-weight: normal;
    padding: 0 8px;
    color: rgba(0,0,0,0.5);
    z-index: 1;
    
    span {
      font-family: var(--font-family-serif);
      font-style: italic;
      font-weight: bold;
      color: rgba(0,0,0,1);
    }
  }

  /* Phone: use a taller portrait frame */
  @media (max-width: 1024px) {
    .hero__text {
      font-size: 56px;
      line-height: 80px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      aspect-ratio: 9 / 16;
      min-height: 420px;
      max-height: 720px;
    }

    .hero__memoji {
      width: 164px;
      transform: translate(10%, -20%);
    }

    .hero__text {
      font-size: 48px;
      line-height: 72px;
    }
  }
</style>
