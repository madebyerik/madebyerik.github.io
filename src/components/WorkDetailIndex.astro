---
import type { WorkId } from "./Card.astro";

interface Props {
  variant: WorkId;
  index: string;
}

const { variant, index } = Astro.props;
---

<div class:list={['index', `index--${variant}`]}>
  <svg
    class="index__svg"
    viewBox="0 0 56 56"
    role="img"
    aria-label={`Project ${index}`}>
    <text x="28" y="28"
      text-anchor="middle" dominant-baseline="middle">
      {index}
    </text>
  </svg>
</div>

<style>
	.index {
    display: flex;
    align-items: center;
    justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 1rem;
	}

  .index__svg {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    overflow: visible;
  }

  .index__svg text {
    font-family: var(--font-family-serif);
    font-size: 2rem;
    font-weight: 700;
    fill: white;
    stroke: black;
    stroke-width: 2px;
    paint-order: stroke fill;
    stroke-linejoin: round;
    filter: drop-shadow(-1px 1px 0px rgba(0, 0, 0, 1));
  }

  .index--btwx {
    background-image: var(--gradient-btwx-200);
  }

  .index--caffeine {
    background-image: var(--gradient-caffeine-200);
  }

  .index--twitch {
    background-image: var(--gradient-twitch-200);
  }

  .index--figma {
    background-image: var(--gradient-figma-200);
  }

  .index--next {
    background-image: var(--gradient-next-200);
  }

  @media (min-width: 48rem) {
    .index {
      width: 4rem;
      height: 4rem;
      border-radius: 1rem;
    }
  }

  @media (min-width: 64rem) {
    
  }
</style>