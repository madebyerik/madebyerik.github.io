---
import logo98 from '../assets/logo98.svg';
---

<div class="nine-eight">
  <div class="window">
    <div class="title-bar">
      <div class="title-bar-title">
        <img class="title-bar-icon" src={logo98.src} draggable="false" />
        <div class="title-bar-text">Portfolio98</div>
      </div>
      <div class="title-bar-controls">
        <button aria-label="Minimize" />
        <button aria-label="Maximize" />
        <button aria-label="Close" />
      </div>
    </div>
    <div class="window-body">
      <div class="window-pre">
        <span>&gt; Hello from <span class="red">P</span><span class="orange">o</span><span class="amber">r</span><span class="yellow">t</span><span class="lime">f</span><span class="green">o</span><span class="emerald">l</span><span class="teal">i</span><span class="cyan">o</span><span class="sky">9</span><span class="blue">8</span>!</span>
        <span>&gt; Would you like to view a retro portfolio with interactive demos?</span>
        <span class="red">&gt; WARNING: Portfolio98 may be infected</span>
        <a href="" class="window-button">View Demo</a>
      </div>
    </div>
    <div class="status-bar">
      <div class="status-bar-field"></div>
      <div class="status-bar-field status-bar-field--resize"></div>
    </div>
  </div>
</div>

<style>
  .nine-eight {
    aspect-ratio: 9 / 16;
    width: 100%;
    min-width: 0;
    min-height: 26rem;
    max-height: 45rem;
    overflow: clip;
    background: url("../assets/98-mobile.png");
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2rem;
    padding: 1rem;
    box-shadow: inset 0 0 10px 0 rgba(0,0,0,0.3), inset 0 0 20px 0 rgba(0,0,0,0.1);
  }

  .window {
    --text-color: #222222;
    --surface: #c0c0c0;
    --button-highlight: #ffffff;
    --button-face: #dfdfdf;
    --button-shadow: #808080;
    --window-frame: #0a0a0a;
    --dialog-blue: #000080;
    --dialog-blue-light: #1084d0;
    --dialog-gray: #808080;
    --dialog-gray-light: #b5b5b5;
    --link-blue: #0000ff;
    --border-window-outer: inset -1px -1px var(--window-frame),
      inset 1px 1px var(--button-face);
    --border-window-inner: inset -2px -2px var(--button-shadow),
      inset 2px 2px var(--button-highlight);
    --border-width: 1px;
    --border-raised-outer: inset -1px -1px var(--window-frame),
      inset 1px 1px var(--button-highlight);
    --border-raised-inner: inset -2px -2px var(--button-shadow),
      inset 2px 2px var(--button-face);
    --border-field: inset -1px -1px var(--button-highlight),
    inset 1px 1px var(--button-shadow), inset -2px -2px var(--button-face),
    inset 2px 2px var(--window-frame);
    --border-status-field: inset -1px -1px var(--button-face), inset 1px 1px var(--button-shadow);
    display: flex;
    flex-direction: column;
    box-shadow: var(--border-window-outer), var(--border-window-inner);
    background: var(--surface);
    padding: 4px;
    -webkit-font-smoothing: none;
    font-size: 16px;
    line-height: 24px;
    max-width: 500px;
  }

  .window button {
    box-sizing: border-box;
    border: none;
    color: transparent;
    text-shadow: 0 0 var(--text-color);
    background: var(--surface);
    box-shadow: var(--border-raised-outer), var(--border-raised-inner);
    border-radius: 0;
    min-width: 75px;
    min-height: 32px;
    padding: 0 24px;
  }

  .window-pre {
    display: flex;
    flex-direction: column;
    background: black;
    box-shadow: var(--border-field);
    font-size: 1rem;
    line-height: 2rem;
    padding: 0.5rem 0.75rem;
    margin: 0;
    color: white;
    font-family: monospace;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    gap: 0.5rem;
    padding-bottom: 1rem;

    * {
      font-family: monospace;
    }
  }

  .red {
    color: var(--color-red-500);
  }

  .orange {
    color: var(--color-orange-500);
  }

  .amber {
    color: var(--color-amber-500);
  }

  .yellow {
    color: var(--color-yellow-500);
  }

  .lime {
    color: var(--color-lime-500);
  }

  .green {
    color: var(--color-green-500);
  }

  .emerald {
    color: var(--color-emerald-500);
  }

  .teal {
    color: var(--color-teal-500);
  }

  .cyan {
    color: var(--color-cyan-500);
  }

  .sky {
    color: var(--color-sky-500);
  }

  .blue {
    color: var(--color-sky-500);
  }

  .window-button {
    color: var(--color-green-500);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--color-green-500);
    font-size: 1rem;
    line-height: 2rem;
    padding: 0.5rem 1rem;
    display: inline-block;
    text-align: center;
  }

  .window-body {
    padding: 4px;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .title-bar {
    background: linear-gradient(
      90deg,
      var(--dialog-blue),
      var(--dialog-blue-light)
    );
    max-height: 32px;
    padding: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .title-bar-title {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
  }

  .title-bar-text {
    font-weight: bold;
    color: white;
    letter-spacing: 0;
    margin-right: 24px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-right: 0;
  }

  .title-bar-icon {
    width: 24px;
    height: 24px;
  }

  .title-bar-controls {
    display: flex;
  }

  .title-bar-controls button {
    padding: 0;
    display: block;
    min-width: 24px;
    min-height: 24px;
  }

  .title-bar-controls button:active {
    padding: 0;
  }

  .title-bar-controls button:focus {
    outline: none;
  }

  .title-bar-controls button[aria-label="Minimize"],
  .title-bar-controls button[aria-label].minimize {
    background-image: url("../assets/minimize.svg");
    background-repeat: no-repeat;
    background-size: 12px 4px;
    background-position: bottom 4px left 6px;
  }

  .title-bar-controls button[aria-label="Maximize"],
  .title-bar-controls button[aria-label].maximize {
    background-image: url("../assets/maximize.svg");
    background-repeat: no-repeat;
    background-size: 16px 16px;
    background-position: top 4px left 4px;
  }

  .title-bar-controls button[aria-label="Close"],
  .title-bar-controls button[aria-label].close {
    margin-left: 2px;
    background-image: url("../assets/close.svg");
    background-repeat: no-repeat;
    background-size: 16px 14px;
    background-position: top 5px left 4px;
  }

  .status-bar {
    display: flex;
    gap: 1px;
    min-height: 24px;
  }

  .status-bar-field {
    box-shadow: var(--border-status-field);
    flex-grow: 1;
    padding: 2px 3px;
    margin: 0;
  }

  .status-bar-field--resize {
    background-image: url("../assets/resize.svg");
    background-repeat: no-repeat;
    background-position: bottom right;
  }

	@media (min-width: 48rem) {
		.nine-eight {
      aspect-ratio: 4 / 3;
      min-height: 40rem;
      max-height: 35rem;
      padding: 2rem;
      background: url("../assets/98.png");
      background-position: center;
    }
  }

	@media (min-width: 64rem) {

  }
</style>
