---
interface Props {
  columns?: 1 | 2;
}

const { columns = 1 } = Astro.props;
---

<div class:list={['grid', { 'grid--2': columns === 2 }]}>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    width: 100%;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      gap: 32px;
    }
  }
</style>