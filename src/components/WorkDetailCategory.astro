---
import type { WorkId } from "./Card.astro";

interface Props {
  variant: WorkId;
  category: string;
}

const { variant, category } = Astro.props;
---

<div>
  <span class:list={['category', `category--${variant}`]}>{category}</span>
</div>

<style>
  .category {
    font-size: 1.125rem;
    line-height: 1.5rem;
    font-family: var(--font-family-serif);
    font-weight: bold;
    font-style: italic;
    color: rgba(0,0,0,0.75);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; 
    color: transparent;
  }

  .category--btwx {
    background-image: var(--gradient-btwx-800);
  }

  .category--caffeine {
    background-image: var(--gradient-caffeine-800);
  }

  .category--twitch {
    background-image: var(--gradient-twitch-800);
  }

  .category--figma {
    background-image: var(--gradient-figma-800);
  }

  .category--next {
    background-image: var(--gradient-next-800);
  }

  @media (min-width: 48rem) {
    .category {
      padding-bottom: 0;
    }
  }

  @media (min-width: 64rem) {

  }
</style>