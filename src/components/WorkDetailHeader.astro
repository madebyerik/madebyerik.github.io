---
import type { WorkId } from "./Card.astro";
import type { CollectionEntry } from 'astro:content';
import WorkDetailPreview from './WorkDetailPreview.astro';
import WorkDetailIndex from './WorkDetailIndex.astro';
import WorkDetailBackButton from './WorkDetailBackButton.astro';
import WorkDetailTags from './WorkDetailTags.astro';
import WorkDetailCategory from './WorkDetailCategory.astro';

interface Props {
  project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const formattedIndex = String(Number(data.index) + 1).padStart(2, '0');
---

<div class="header">
  <div class="header__left">
    <div class="header__nav">
      <WorkDetailBackButton
        variant={id as WorkId} />
      <WorkDetailIndex
        variant={id as WorkId}
        index={formattedIndex} />
    </div>
    <div class="header__info">
      <WorkDetailCategory
       variant={id as WorkId}
       category={data.category} />
      <h3 class="header__title">{data.title}</h3>
      <p class="header__description">{data.description}</p>
    </div>
    <WorkDetailTags
      variant={id as WorkId}
      tags={data.tags} />
  </div>
  <div class="header__right">
    <WorkDetailPreview
      variant={id as WorkId}
      src={data.img.src}
      alt={data.img_alt} />
  </div>
</div>

<style>
	.header {
    display: flex;
    flex-direction: column;
    padding: 24px 16px;
    gap: 24px;
    min-width: 0;
  }

  .header__left {
    display: flex;
    flex-direction: column;
    justify-content: start;
    gap: 24px;
    min-width: 0;
    width: auto;
  }

	.header__nav {
		display: flex;
		justify-content: space-between;
	}

  .header__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .header__title {
    font-size: 48px;
    line-height: 56px;
    font-family: var(--font-family-serif);
    font-weight: bold;
    font-style: italic;
    color: black;
  }

  .header__description {
    font-size: 20px;
    line-height: 32px;
    font-family: var(--font-family-sans);
    color: rgba(0,0,0,0.5);
  }

  @media (min-width: 768px) {
    .header {
      flex-direction: row;
      justify-content: space-between;
      gap: clamp(24px, 4vw, 48px);
			padding: 32px 8px;
    }

    .header__left {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .header__right {
      flex: 0 1 clamp(240px, 38vw, 360px);
      width: auto;
      min-width: 0;
    }
  }

  @media (min-width: 1024px) {
    .header {
      gap: 64px;
    }

    .header__right {
      flex-basis: 400px;
    }
  }
</style>