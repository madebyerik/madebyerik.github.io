---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WorkDetailHeader from '../../components/WorkDetailHeader.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
	<div class="wrapper">
		<div class="stack">
			<WorkDetailHeader project={entry} />
			<div class:list={['prose', `prose--${entry.id}`]}>
				<Content />
			</div>
		</div>
	</div>
</Layout>

<style>
	.prose {
		/* background: white;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.1); */
		border-radius: 2rem;
		/* padding: 0 0.75rem; */
		/* margin: 0 auto;
		max-width: 720px; */
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
	.prose :global(h4),
	.prose :global(h5),
	.prose :global(h6),
	.prose :global(pre),
	.prose :global(code),
	.prose :global(blockquote) {
		max-width: 720px;
		margin-left: auto;
		margin-right: auto;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		font-size: clamp(1rem, 0.85rem + 0.6vw, 1.25rem);
  	line-height: 1.5;
	}

	/* .prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 2rem;
	}

	.prose :global(ul) :global(li),
	.prose :global(ol) :global(li) {
		padding-left: 0.5rem;
	} */

	/* .prose :global(ul) :global(li) {
		list-style-image: url('data:image/svg+xml,<svg width="8" height="9" viewBox="0 0 8 9" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="3.5" cy="4.5" r="3.5" fill="black"/><circle cx="4.5" cy="3.5" r="3" fill="white" stroke="black"/></svg>');
	} */

	.prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    line-height: 1.25;
		margin-block: 1.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre) {
    margin-block: 1.5rem;
  }

  .prose :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 0.25rem;
    background: #252525;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #171717;
  }

  .prose :global(blockquote) {
		position: relative;
    padding-left: 1rem;
		font-family: var(--font-family-serif);
		font-weight: normal;
		font-style: italic;
		background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; 
    color: transparent;

		> :global(p) {
			font-size: clamp(1.5rem, 1.0000rem + 0.95vw, 2rem);
  		line-height: 1.5;
			margin-block: 2rem;
		}
    
		&:before {
			content: '';
			position: absolute;
			left: 0;
			top: 0;
			height: 100%;
			width: 0.25rem;
			border-radius: 0.25rem;
			background: red;
		}
  }

	.prose :global(a):not(:has(*)) {
		position: relative;
		font-family: var(--font-family-serif);
		font-style: italic;
		font-weight: bold;
		background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; 
    color: transparent;
		text-decoration: none;
    
		&:before {
			content: '';
			position: absolute;
			left: 0;
			bottom: -2px;
			height: 2px;
			width: 100%;
			border-radius: 1px;
			background: red;
		}
  }

	.prose :global(p):has(img) {
		padding: 1.5rem 1.5rem 1.5rem 1.65rem;
		border-radius: 1.5rem;
		margin-block: 2rem;
		max-width: 100%;
	}

  .prose :global(img) {
    max-width: 100%;
    border-radius: 1.5rem;
		object-fit: contain;
		height: auto;
		box-shadow: 0 0 0 1px black, -3px 3px 0 0 black;
    border-radius: 1rem;
		background: rgba(0,0,0,0.75);
  }

	.prose--btwx :global(p):has(img) {
    background: var(--gradient-btwx-200);
  }

	.prose--caffeine :global(p):has(img) {
    background: var(--gradient-caffeine-200);
  }

	.prose--twitch :global(p):has(img) {
    background: var(--gradient-twitch-200);
  }

	.prose--figma :global(p):has(img) {
    background: var(--gradient-figma-200);
  }

	.prose--next :global(p):has(img) {
    background: var(--gradient-next-200);
  }

	.prose--btwx :global(blockquote),
	.prose--btwx :global(a):not(:has(*)) {
		background-image: var(--gradient-btwx-800);

		&:before {
			background: var(--gradient-btwx-200);
		}
	}

	.prose--caffeine :global(blockquote),
	.prose--caffeine :global(a):not(:has(*)) {
		background-image: var(--gradient-caffeine-800);

		&:before {
			background: var(--gradient-caffeine-200);
		}
	}

	.prose--twitch :global(blockquote),
	.prose--twitch :global(a):not(:has(*)) {
		background-image: var(--gradient-twitch-800);

		&:before {
			background: var(--gradient-twitch-200);
		}
	}

	.prose--figma :global(blockquote),
	.prose--figma :global(a):not(:has(*)) {
		background-image: var(--gradient-figma-800);

		&:before {
			background: var(--gradient-figma-200);
		}
	}

	.prose--next :global(blockquote),
	.prose--next :global(a):not(:has(*)) {
		background-image: var(--gradient-next-800);

		&:before {
			background: var(--gradient-next-200);
		}
	}

  @media (min-width: 48rem) {
    .prose {
			/* padding: 0 1.5rem; */
		}

		.prose :global(p):has(img) {
			padding: 2rem 2rem 2rem 2.35rem;
			border-radius: 1.5rem;
		}

		.prose :global(blockquote) {
			padding-left: 1.5rem;
		}
  }

  @media (min-width: 64rem) {
    .prose :global(h1),
		.prose :global(h2),
		.prose :global(h3) {
			margin-block: 2.5rem;
		}

		.prose :global(p):has(img) {
			margin-block: 3rem;
		}

		.prose :global(blockquote) {
			> :global(p) {
				margin-block: 3rem;
			}
		}

		.prose :global(p),
		.prose :global(ul),
		.prose :global(ol),
		.prose :global(pre) {
			margin-block: 2rem;
		}
  }
</style>

<script>
  const images = document.querySelectorAll('.prose img');
  
  images.forEach((img) => {
    const imageEl = img as HTMLImageElement;
    
    const link = document.createElement('a');
    link.href = imageEl.src;
    link.target = '_blank';
    // link.className = 'clickable-image-wrapper';
    
    imageEl.parentNode?.insertBefore(link, imageEl);
    link.appendChild(imageEl);
  });
</script>