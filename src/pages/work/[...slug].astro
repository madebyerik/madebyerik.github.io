---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WorkDetailHeader from '../../components/WorkDetailHeader.astro'

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
	<div class="wrapper">
		<div class="stack">
			<WorkDetailHeader project={entry} />
			<div class:list={['prose', `prose--${entry.id}`]}>
				<Content />
			</div>
		</div>
	</div>
</Layout>

<style>
	.prose {
		background: white;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
		border-radius: 32px;
		padding: 16px;
	}

	.prose :global(p) {
		font-size: clamp(1rem, 0.85rem + 0.5vw, 1.25rem);
  	line-height: 1.5;
	}

	.prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre) {
    margin-block: 1.25rem;
  }

  .prose :global(a) {
    color: red;
    text-underline-offset: 0.2em;
  }

  .prose :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 0.25rem;
    background: #252525;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #171717;
  }

  .prose :global(blockquote) {
		position: relative;
    padding-left: 1.5rem;
		font-family: var(--font-family-serif);
		font-weight: bold;
		font-style: italic;
		background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; 
    color: transparent;

		> :global(p) {
			font-size: clamp(1.25rem, 1.0000rem + 0.95vw, 2.0rem);
  		line-height: 1.5;
		}
    
		&:before {
			content: '';
			position: absolute;
			left: 0;
			top: 0;
			height: 100%;
			width: 0.75rem;
			border-radius: 0.375rem;
			background: red;
		}
  }

	.prose :global(p):has(img) {
		padding: 1.5rem 1.5rem 1.6rem 1.5rem;
		border-radius: 1.5rem;
	}

  .prose :global(img) {
    max-width: 100%;
    border-radius: 1.5rem;
		object-fit: contain;
		height: auto;
		box-shadow: 0 0 0 1px black, -3px 3px 0 0 black;
    border-radius: 1rem;
  }

	.prose--btwx :global(p):has(img) {
    background: var(--gradient-btwx-100);
  }

	.prose--caffeine :global(p):has(img) {
    background: var(--gradient-caffeine-100);
  }

	.prose--twitch :global(p):has(img) {
    background: var(--gradient-twitch-100);
  }

	.prose--figma :global(p):has(img) {
    background: var(--gradient-figma-100);
  }

	.prose--btwx :global(blockquote) {
		background-image: var(--gradient-btwx-800);

		&:before {
			background: var(--gradient-btwx-100);
		}
	}

	.prose--caffeine :global(blockquote) {
		background-image: var(--gradient-caffeine-800);

		&:before {
			background: var(--gradient-caffeine-100);
		}
	}

	.prose--twitch :global(blockquote) {
		background-image: var(--gradient-twitch-800);

		&:before {
			background: var(--gradient-twitch-100);
		}
	}

	.prose--figma :global(blockquote) {
		background-image: var(--gradient-figma-800);

		&:before {
			background: var(--gradient-figma-100);
		}
	}

  @media (min-width: 768px) {
    .prose {
			background: white;
			box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
			border-radius: 32px;
			padding: 24px;
		}

		.prose :global(p):has(img) {
			padding: 2rem 2rem 1.9rem 2rem;
			border-radius: 1.5rem;
		}

		.prose :global(blockquote) {
			/* font-size: 2rem;
			line-height: 3rem; */
			padding-left: 2rem;
		}
  }

  @media (min-width: 1024px) {
    .prose {
			background: white;
			box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
			border-radius: 32px;
			padding: 32px;
		}
  }
</style>

<script>
  const images = document.querySelectorAll('.prose img');
  
  images.forEach((img) => {
    const imageEl = img as HTMLImageElement;
    
    const link = document.createElement('a');
    link.href = imageEl.src;
    link.target = '_blank';
    // link.className = 'clickable-image-wrapper';
    
    imageEl.parentNode?.insertBefore(link, imageEl);
    link.appendChild(imageEl);
  });
</script>