---
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import aboutMemoji from '../assets/memoji-wave.png';
import workMemoji from '../assets/memoji-macbook.png';
import contactMemoji from '../assets/memoji-call.png';
import AboutCard from "../components/AboutCard.astro";
import dribbbleIcon from "../assets/dribbble-icon.svg";
import figmaIcon from "../assets/figma-icon.svg";
import githubIcon from "../assets/github-icon.svg";
import WorkCard from "../components/WorkCard.astro";
import ContactCard from '../components/ContactCard.astro';
import Grid from '../components/Grid.astro';
import AllWorkButton from '../components/AllWorkButton.astro';


const projects = (await getCollection('work'))
	.sort((a, b) => a.data.index - b.data.index)
	.slice(0, 4);
---

<Layout>
	<div class="wrapper">
		<div class="stack gap-6 md:gap-8">
			<Hero />
			<div class="stack gap-8 md:gap-14">
				<div class="stack gap-8 md:gap-14">
					<!-- about -->
					<div class="section__info">
						<div class="section__header">
							<img class="section__img" src={aboutMemoji.src} />
							<h1 class="section__title">About</h1>
						</div>
						<p class="section__text">I design, code, prototype, animate, test, break, rebuild, and ship cool stuff.</p>
					</div>
					<Grid columns={2}>
						<AboutCard
							href="https://dribbble.com/madebyerik"
							variant="pink"
							title="UI/UX"
							icon={dribbbleIcon.src}
							skills={[["Wireframing", "Prototyping", "Mockups", "Redlining"], ["User Flows", "Design Systems", "Design Tokens", "Accessibility"]]} />
						<AboutCard
							href="https://www.figma.com/@madebyerik"
							variant="purple"
							title="Design Tools"
							icon={figmaIcon.src}
							skills={[["Figma", "Sketch", "Adobe CC", "Blender"], ["Principle", "Framer", "VS Code", "AI"]]} />
						<AboutCard
							href="https://github.com/madebyerik"
							variant="green"
							title="Programming"
							icon={githubIcon.src}
							skills={[["JavaScript", "TypeScript", "Python", "SQL", "Node", "HTML", "CSS", "Scss/Sass"], ["React/Angular", "D3", "Phaser", "Three/Fiber", "Git", "Vite", "Webpack", "Astro"]]} />
					</Grid>
				</div>
				<div class="stack gap-8 md:gap-14">
					<!-- work -->
					<div class="section__info">
						<div class="section__header">
							<img class="section__img" src={workMemoji.src} />
							<h1 class="section__title">Work</h1>
						</div>
						<p class="section__text">Deep dives and other awesome things to explore.</p>
					</div>
					<Grid>
						{projects.map((project: any) => (
							<WorkCard project={project} />
						))}
					</Grid>
					<AllWorkButton />
				</div>
				<div class="stack gap-8 md:gap-14">
					<!-- contact -->
					<div class="section__info">
						<div class="section__header">
							<img class="section__img" src={contactMemoji.src} />
							<h1 class="section__title">Contact</h1>
						</div>
						<p class="section__text">If you’d like to get in touch, my LinkedIn is below.</p>
					</div>
					<Grid columns={2}>
						<ContactCard />
					</Grid>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.section__info {
		display: flex;
		flex-direction: column;
		padding: 0 0.75rem;
	}

	.section__header {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.section__img {
		width: clamp(3rem, 5.8vw, 4rem);
		background: white;
		box-shadow: 0 0 0 1px black, -2px 2px 0 0 black;
		border-radius: 100%;
	}

	.section__title {
		font-size: clamp(3rem, 4.4vw + 1rem, 4rem);
		line-height: 1.5;
		font-family: var(--font-family-serif);
		font-style: italic;
		font-weight: bold;
		color: black;
	}

	.section__text {
		font-size: clamp(1.25rem, 3vw + 0.16rem, 2.25rem);
		line-height: 1.5;
		font-family: var(--font-family-sans);
		color: rgba(0,0,0,0.5);
	}

	@media (min-width: 48rem) {
    /* .all-work-button {
			font-size: 1.75rem;
			line-height: 2.25rem;
		} */
  }

  @media (min-width: 64rem) {
		
  }
</style>