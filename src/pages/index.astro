		.section {
			gap: 64px;
		}

		.section__img {
			width: 64px;
			height: 64px;
		}

    .section__title {
			font-size: 64px;
			line-height: 88px;
		}

		.section__text {
			font-size: 40px;
			line-height: 56px;
		}
  } */
</style>