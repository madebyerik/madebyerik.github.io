---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import workMemoji from '../assets/memoji-macbook.png';
import WorkCard from "../components/WorkCard.astro";
import Grid from '../components/Grid.astro';


const projects = (await getCollection('work'))
	.sort((a, b) => a.data.index - b.data.index);
---

<Layout>
	<div class="wrapper">
		<div class="stack">
			<div class="header">
				<img class="header__memoji" src={workMemoji.src} />
				<h1 class="header__title">Work</h1>
			</div>
			<Grid>
				{projects.map((project: any) => (
					<WorkCard project={project} />
				))}
			</Grid>
		</div>
	</div>
</Layout>

<style>
	.header {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		padding: 3rem 0 2rem 0;
	}

	.header__title {
		font-size: clamp(3rem, 4.4vw + 1rem, 4rem);
		line-height: 1.5;
		font-family: var(--font-family-serif);
		font-style: italic;
		font-weight: bold;
		color: black;
	}

	.header__memoji {
		width: clamp(6rem, 11vw, 8rem);
		background: white;
		box-shadow: 0 0 0 1.5px black, -3px 3px 0 0 black;
		border-radius: 100%;
	}

	@media (min-width: 768px) {
		
  }

	@media (min-width: 1024px) {
		
  }
</style>
