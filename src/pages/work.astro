---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import workMemoji from '../assets/memoji-macbook.png';
import WorkCard from "../components/WorkCard.astro";
import Grid from '../components/Grid.astro';


const projects = (await getCollection('work'))
	.sort((a, b) => a.data.index - b.data.index);
---

<Layout>
	<div class="work">
		<div class="work__hero">
			<img class="work__memoji" src={workMemoji.src} />
			<h1 class="work__header">Work</h1>
		</div>
		<Grid>
			{projects.map((project: any) => (
				<WorkCard project={project} />
			))}
		</Grid>
	</div>
</Layout>

<style>
	.work {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 32px 0;
	}

	.work__hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 16px;
		padding: 32px 0;
	}

	.work__header {
		font-size: 48px;
    line-height: 56px;
		font-family: var(--font-family-serif);
		font-style: italic;
		font-weight: bold;
		color: black;
	}

	.work__memoji {
		width: 96px;
		height: 96px;
		background: white;
		box-shadow: 0 0 0 1.5px black, -3px 3px 0 0 black;
		border-radius: 100%;
	}

	@media (min-width: 768px) {
		.work__memoji {
			width: 112px;
			height: 112px;
		}

    .work__header {
			font-size: 56px;
			line-height: 64px;
		}
  }
</style>
